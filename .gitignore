# Secrets & generated artifacts - never commit these
.env
nginx/certs/*.crt
nginx/certs/*.key
nginx/certs/.htpasswd

# Backups & logs
backups/
*.log
shots/*.png

# Lokale Nginx-Zusatzconfig mit Tokens (Beispieldatei bleibt versioniert)
nginx/conf.d/extra/*.conf
!nginx/conf.d/extra/*.example

# Zentrale Konfiguration (URLs + Zugangsdaten) - nur die .example-Dateien
config/*.env
!config/*.env.example

# Laufzeit-Zustand des CVE-Watchers (gesehene CVEs)
state/

# Python-Bytecode
__pycache__/
*.pyc

# Eigene Prüfziele der Sonde (Beispieldatei bleibt versioniert)
config/probes.txt
# Seitenliste der Wand (Beispieldatei bleibt versioniert)
config/pages.txt
config/sources.txt
config/cve-feeds.txt

# Gerenderte Grafana-Datenquelle enthaelt den Zabbix-Token
grafana/provisioning/datasources/zabbix.yml

# Wandseiten je Zabbix-Hostgruppe: erzeugt aus config/gruppen.txt (gitignored).
# Sie gehoeren niemandem ausser dem jeweiligen Pi - waeren sie versioniert,
# wuerde jeder Build die Dateien des anderen loeschen. Angelegt von
# ./scripts/build-dashboards.py, das ./scripts/update.sh ohnehin aufruft.
# lagebild/infra/security bleiben versioniert: die entstehen nur aus Code.
grafana/dashboards/noc-*.json
config/news.txt
config/gruppen.txt
config/connect.ini
config/katalog.txt
config/infoboard.txt
