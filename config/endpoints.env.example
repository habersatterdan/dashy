# =============================================================================
# ZENTRALE STELLE 1/2:  URLs eurer On-Prem-Dienste
# -----------------------------------------------------------------------------
# Hier - und nur hier - trägst du Adressen ein. Danach:
#     ./scripts/render-config.py && docker compose restart dashy
#
# Kopieren:  cp config/endpoints.env.example config/endpoints.env
# Die echte Datei ist gitignored und überlebt jedes "git reset --hard".
# Nicht benötigte Zeilen einfach leer lassen - die Kachel entfällt dann.
# =============================================================================

# --- Monitoring ---------------------------------------------------------------
# Nur die BASIS eintragen - nicht die URL aus der Adresszeile kopieren.
#   richtig:  http://server.firma.local/zabbix    (Paketinstallation)
#   richtig:  https://zabbix.firma.local          (Container, liegt auf /)
#   falsch:   .../zabbix.php?action=dashboard.view&kiosk=1
# Und immer den vollen Namen (FQDN): Kurznamen loesen im Container nicht auf.
ZABBIX_URL=https://zabbix.example.local
GRAFANA_URL=https://grafana.example.local
PRTG_URL=https://prtg.example.local
CHECKMK_URL=https://checkmk.example.local/mysite

# --- Virtualisierung / Server -------------------------------------------------
VCENTER_URL=https://vcenter.example.local
SCVMM_URL=https://scvmm.example.local
SQL_URL=https://sql-monitor.example.local

# --- Netzwerk / Security ------------------------------------------------------
FIREWALL_URL=https://firewall.example.local
CATALYST_URL=https://dnac.example.local
ISE_URL=https://ise.example.local/admin
VMANAGE_URL=https://vmanage.example.local
WAN_MONITOR_URL=https://wan-monitor.example.local

# --- Betrieb ------------------------------------------------------------------
BACKUP_URL=https://backup.example.local
INTRANET_URL=https://intranet.example.local
ERP_URL=https://erp.example.local
STATUS_URL=https://status.example.local

# =============================================================================
# WEBOBERFLAECHEN AUF DER WAND EINBETTEN  (Grafana, PRTG, CheckMK, vCenter ...)
# -----------------------------------------------------------------------------
# Die meisten Anwendungen verbieten das Einbetten (X-Frame-Options / CSP) - ein
# <iframe> darauf bleibt wortlos leer. Ueber den Proxy laufen sie unter EURER
# Adresse, und die Sperre wird entfernt.
#
# Je Anwendung zwei Zeilen. SLUG ist der Pfad, unter dem sie bei euch
# erscheint; URL ist die Basisadresse - immer mit vollem Namen (FQDN),
# Kurznamen loesen im Container nicht auf.
#
#   EMBED1_SLUG=grafana
#   EMBED1_URL=https://grafana.firma.local
#     -> erreichbar unter https://<pi>/grafana/
#     -> in config/pages.txt:   Grafana | /grafana/ | 60
#
# Zabbix braucht das NICHT: dafuer gibt es ZABBIX_URL weiter oben.
# Nicht benutzte Plaetze einfach leer lassen.
# =============================================================================
EMBED1_SLUG=
EMBED1_URL=
EMBED2_SLUG=
EMBED2_URL=
EMBED3_SLUG=
EMBED3_URL=
EMBED4_SLUG=
EMBED4_URL=

# =============================================================================
# WEITERE RSS-/ATOM-FEEDS  (erscheinen unter /feeds/<slug>)
# -----------------------------------------------------------------------------
# Fest eingebaut sind: m365, azure, cisco, bsi, cisa, heise-alerts,
# heise-security, kev. Hier lassen sich sechs weitere ergaenzen.
#
#   FEED1_SLUG=fortinet
#   FEED1_URL=https://.../rss.xml
#     -> /feeds/fortinet
#     -> in config/sources.txt:   Fortinet | fortinet
#
# WICHTIG: Feed-Adressen aendern sich. Nach dem Eintragen IMMER
#     ./scripts/check-feeds.sh
# ausfuehren. Eine tote Quelle erzeugt auf /stoerungen/ dauerhaft eine rote
# Karte - und dauerhaft Rotes stumpft ab, bis niemand mehr hinsieht.
#
# Sinnvolle Kandidaten fuer euren Stack (Adressen beim Anbieter nachschlagen,
# nicht raten): Fortinet PSIRT, VMware/Broadcom Security, Veeam, Sophos,
# Atlassian Status, GitHub Status, Let's Encrypt Status, Docker Hub Status,
# heise Security, Golem Security, CERT-Bund Buergermeldungen.
# =============================================================================
# Vorbelegt mit den beiden Anbieter-Statusfeeds. PRUEFEN mit
# ./scripts/check-feeds.sh - Microsoft hat diese Adressen mehrfach geaendert.
# Meldet die Pruefung einen Fehler, hier die aktuelle Adresse eintragen; ein
# Update des Codes ist dafuer nicht noetig.
FEED1_SLUG=m365
FEED1_URL=https://status.cloud.microsoft/api/feed/rss
FEED2_SLUG=azure
FEED2_URL=https://azure.status.microsoft/en-us/status/feed/
FEED3_SLUG=
FEED3_URL=
FEED4_SLUG=
FEED4_URL=
FEED5_SLUG=
FEED5_URL=
FEED6_SLUG=
FEED6_URL=
