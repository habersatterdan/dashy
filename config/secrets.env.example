# =============================================================================
# ZENTRALE STELLE 2/2:  API-Keys und Zugangsdaten
# -----------------------------------------------------------------------------
# Kopieren und absichern:
#     cp config/secrets.env.example config/secrets.env
#     chmod 600 config/secrets.env
#
# Diese Datei ist gitignored - sie darf NIE committet werden.
# Verwende überall nur-lesende Konten/Token.
# =============================================================================

# --- Zabbix (Users -> API tokens, nur-lesende Rolle) --------------------------
ZABBIX_API_TOKEN=

# --- Grafana (Service-Account-Token, Viewer) ----------------------------------
GRAFANA_TOKEN=

# --- Cisco Catalyst Center (X-Auth-Token, läuft ~1 h ab) ----------------------
CATALYST_TOKEN=

# --- Cisco SD-WAN / vManage ---------------------------------------------------
VMANAGE_SESSION=
VMANAGE_XSRF=

# --- Microsoft Graph (App-Registrierung, ServiceHealth.Read.All) --------------
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# --- Wetter (OpenWeatherMap) --------------------------------------------------
WEATHER_API_KEY=

# --- CVE-Watcher: Webhook-Ziel und NVD --------------------------------------
# Wohin die JSON-Meldungen gehen (Ticketsystem, Alerting-Tool, Teams-Connector).
CVE_WEBHOOK_URL=
# Optionaler Auth-Header, Format "Name: Wert", z. B. "Authorization: Bearer xyz"
CVE_WEBHOOK_AUTH_HEADER=
# NVD-API-Key (kostenlos bei nvd.nist.gov) - ohne Key gilt ein enges Rate-Limit
NVD_API_KEY=

# --- Universalanschluss (config/connect.ini) ---------------------------------
# Hier stehen die WERTE, in connect.ini nur die NAMEN dieser Variablen.
# So bleibt connect.ini frei von Geheimnissen.
# Die Namen sind frei waehlbar - diese hier sind nur die ueblichen.
# Legt in der jeweiligen Anwendung einen eigenen LESENDEN Benutzer an:
# der Token liegt auf einem Geraet, das im Flur haengt.
JIRA_TOKEN=
LOGINV_USER=
LOGINV_PASS=
