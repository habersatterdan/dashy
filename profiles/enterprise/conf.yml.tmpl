# =============================================================================
# NOC / Datacenter Digital Signage - Main configuration
# Page 1 (Übersicht) lives here; content pages are loaded from ./pages/*.yml
# NICHT DIREKT BEARBEITEN - dies ist die Vorlage.
# URLs stehen zentral in config/endpoints.env, Keys in config/secrets.env.
# Danach:  ./scripts/render-config.py  ->  erzeugt conf.yml daneben.
# =============================================================================

pageInfo:
  title: NOC Signage
  description: Datacenter Operations Wall
  # Nav buttons are generated automatically from the pages: block below,
  # so we do NOT list them here (that would create duplicate buttons).

appConfig:
  theme: nord-frost
  layout: auto
  iconSize: large             # big, wall-readable tiles
  statusCheck: true           # green/red reachability dot per tile
  statusCheckInterval: 30
  disableConfiguration: true
  hideComponents:
    hideSettings: true
    hideFooter: true
  enableErrorReporting: false
  customCss: >
    :root { --primary: #00e676; --background: #0b0f14; }

# --- Content pages (each becomes a URL + a nav button) -----------------------
pages:
  - name: Störungen
    path: pages/stoerungen.yml
  - name: Security
    path: pages/security.yml
  - name: Updates
    path: pages/updates.yml

# =============================================================================
# PAGE 1 - ÜBERSICHT (Ampel-Kacheln: was läuft, was nicht - kein Login nötig)
# =============================================================================
sections:
  - name: Kernsysteme
    icon: fas fa-server
    displayData:
      cols: 3
    items:
      - title: Zabbix
        icon: fas fa-chart-line
        url: ${ZABBIX_URL}
        statusCheck: true
      - title: M365 Service Health
        icon: si-microsoftoffice
        url: https://admin.microsoft.com/Adminportal/Home#/servicehealth
        statusCheck: true
      - title: M365 Status
        icon: si-microsoft
        url: https://status.office365.com
        statusCheck: true

  - name: Infrastruktur
    icon: fas fa-network-wired
    displayData:
      cols: 3
    items:
      - title: VMware vCenter
        icon: si-vmware
        url: ${VCENTER_URL}
        statusCheck: true
      - title: Firewall
        icon: fas fa-shield-halved
        url: ${FIREWALL_URL}
        statusCheck: true
      - title: Backup
        icon: fas fa-database
        url: ${BACKUP_URL}
        statusCheck: true

  - name: Zeit
    icon: fas fa-clock
    displayData:
      cols: 1
    widgets:
      - type: clock
        options:
          timeZone: Europe/Berlin
          format: de-DE
          hideDate: false
