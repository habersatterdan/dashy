# -----------------------------------------------------------------------------
# NOC Digital Signage - environment configuration
# Copy to ".env" and adjust for your site:  cp .env.example .env
# -----------------------------------------------------------------------------

# Timezone used by containers (Watchtower schedule, backup cron, clock widget).
TZ=Europe/Berlin

# -----------------------------------------------------------------------------
# Content profile to load from ./profiles/<name>/ (conf.yml + pages/*.yml).
# Ships with two starters:
#   enterprise - the original NOC/datacenter wall (Zabbix, Cisco, M365, ...)
#   homelab    - self-hosted homelab starter (Grafana/Pi-hole/Nextcloud/... + public RSS)
# Add your own by copying a profiles/<name>/ folder and pointing this at it.
# -----------------------------------------------------------------------------
DASHY_PROFILE=enterprise

# -----------------------------------------------------------------------------
# The values below are NOT read by docker-compose directly. They document the
# placeholders you must replace inside dashy/conf.yml and dashy/pages/*.yml.
# They are kept here as a single reference sheet for the deployment.
# -----------------------------------------------------------------------------

# --- Monitoring endpoints (internal, reachable from the Pi) ------------------
ZABBIX_URL=https://zabbix.example.local
ZABBIX_API_TOKEN=REPLACE_WITH_ZABBIX_API_TOKEN
GRAFANA_URL=https://grafana.example.local
PRTG_URL=https://prtg.example.local
CHECKMK_URL=https://checkmk.example.local/mysite

# --- Microsoft 365 -----------------------------------------------------------
M365_TENANT_ID=REPLACE_WITH_TENANT_ID
M365_CLIENT_ID=REPLACE_WITH_CLIENT_ID
M365_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET

# --- Cisco -------------------------------------------------------------------
CATALYST_CENTER_URL=https://dnac.example.local
CISCO_ISE_URL=https://ise.example.local
CISCO_SECURE_ACCESS_URL=https://dashboard.sse.cisco.com

# --- Network / Firewall / WAN ------------------------------------------------
FIREWALL_URL=https://firewall.example.local
WAN_MONITOR_URL=https://wan-monitor.example.local

# --- Weather widget ----------------------------------------------------------
# OpenWeatherMap city id / units for the automatic weather widget.
WEATHER_CITY=Vienna,AT
WEATHER_API_KEY=REPLACE_WITH_OPENWEATHERMAP_KEY
WEATHER_UNITS=metric
