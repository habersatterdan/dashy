# -----------------------------------------------------------------------------
# NOC Digital Signage - environment configuration
# Copy to ".env" and adjust for your site:  cp .env.example .env
# -----------------------------------------------------------------------------

# Timezone used by containers (Watchtower schedule, backup cron, clock widget).
TZ=Europe/Berlin

# -----------------------------------------------------------------------------
# Content profile to load from ./profiles/<name>/ (conf.yml + pages/*.yml).
# Ships with two starters:
#   enterprise - the original NOC/datacenter wall (Zabbix, Cisco, M365, ...)
#   homelab    - self-hosted homelab starter (Grafana/Pi-hole/Nextcloud/... + public RSS)
# Add your own by copying a profiles/<name>/ folder and pointing this at it.
# -----------------------------------------------------------------------------
DASHY_PROFILE=enterprise

# -----------------------------------------------------------------------------
# The values below are NOT read by docker-compose directly. They document the
# placeholders you must replace inside dashy/conf.yml and dashy/pages/*.yml.
# They are kept here as a single reference sheet for the deployment.
# -----------------------------------------------------------------------------

# --- Monitoring endpoints (internal, reachable from the Pi) ------------------
ZABBIX_URL=https://zabbix.example.local
ZABBIX_API_TOKEN=REPLACE_WITH_ZABBIX_API_TOKEN
GRAFANA_URL=https://grafana.example.local
PRTG_URL=https://prtg.example.local
CHECKMK_URL=https://checkmk.example.local/mysite

# --- Microsoft 365 -----------------------------------------------------------
M365_TENANT_ID=REPLACE_WITH_TENANT_ID
M365_CLIENT_ID=REPLACE_WITH_CLIENT_ID
M365_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET

# --- Cisco -------------------------------------------------------------------
CATALYST_CENTER_URL=https://dnac.example.local
CISCO_ISE_URL=https://ise.example.local
CISCO_SECURE_ACCESS_URL=https://dashboard.sse.cisco.com

# --- Network / Firewall / WAN ------------------------------------------------
FIREWALL_URL=https://firewall.example.local
WAN_MONITOR_URL=https://wan-monitor.example.local

# --- Weather widget ----------------------------------------------------------
# OpenWeatherMap city id / units for the automatic weather widget.
WEATHER_CITY=Vienna,AT
WEATHER_API_KEY=REPLACE_WITH_OPENWEATHERMAP_KEY
WEATHER_UNITS=metric

# --- CVE-Watcher --------------------------------------------------------------
# true = nur ins Log schreiben, nichts senden. Erst auf false stellen, wenn die
# Logs zeigen, dass die richtigen Meldungen erkannt werden.
CVE_DRY_RUN=true
CVE_MIN_CVSS=7.0          # ab welchem CVSS gemeldet wird (P2); >=9.0 und KEV = P1
CVE_POLL_SECONDS=1800     # alle 30 Minuten
CVE_MAX_PER_RUN=10        # hoechstens so viele Funde je Durchlauf
# true  = EIN gebuendelter Webhook je Durchlauf mit allen Funden (Standard)
# false = ein eigener Webhook je CVE - erzeugt bei Rueckstand eine Flut
CVE_BATCH=true

# --- Betriebslage-Sonde (services/probe) --------------------------------------
# Prueft die Ziele aus config/probes.txt. Ergebnis: /data/probe.json -> /lage/
PROBE_INTERVAL=60         # Sekunden zwischen zwei Messungen
PROBE_TIMEOUT=8           # Zeitlimit je Pruefung
PROBE_SLOW_MS=2000        # ab dieser Antwortzeit gilt ein Dienst als langsam
PROBE_CERT_WARN_DAYS=30   # Zertifikatswarnung (gelb)
PROBE_CERT_CRIT_DAYS=7    # Zertifikatswarnung (rot)
PROBE_VERIFY_TLS=false    # interne Zertifikate: Erreichbarkeit zaehlt, nicht die CA
# Suchdomaene fuer Kurznamen ohne Punkt. Leer lassen und FQDNs eintragen ist
# der sicherere Weg; hier gesetzt wird sie an punktlose Namen angehaengt.
PROBE_DNS_SUFFIX=

# --- Interne Namen, die Docker nicht aufloest ---------------------------------
# Container nutzen Dockers DNS und kennen die Suchdomaene des Firmennetzes
# nicht. Wenn ./scripts/check-zabbix.sh in Schritt 2 rot ist, hier fest
# eintragen - Format "name:ip", ohne Anfuehrungszeichen:
#   EXTRA_HOST_1=srvdemev0091o.de.zott.corp:10.30.191.15
EXTRA_HOST_1=
EXTRA_HOST_2=

# --- Watchtower ---------------------------------------------------------------
# Ohne feste API-Version scheitert Watchtower mit "client version 1.25 is too
# old" und startet endlos neu.
DOCKER_API_VERSION=1.44
