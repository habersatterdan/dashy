# -----------------------------------------------------------------------------
# Zabbix-Oberflaeche fuer eingebettete Dashboards.
#
# Braucht NUR ZABBIX_URL - keinen API-Token. Deshalb eine eigene Datei: fehlt
# der Token, wird nur zabbix-api.conf uebersprungen, das Einbetten von
# Dashboards funktioniert trotzdem.
#
# WARUM DER PROXY NOETIG IST: Zabbix sendet "X-Frame-Options: SAMEORIGIN".
# Ein <iframe> auf https://zabbix.example.local bleibt darum von unserer Wand
# aus leer - der Browser blockt es wortlos. Ueber diesen Proxy laeuft Zabbix
# unter UNSERER Adresse, also same-origin, und die Kopfzeile wird zusaetzlich
# entfernt. Erst dadurch wird das Bild sichtbar.
#
# EINRICHTEN:
#   1. ZABBIX_URL in config/endpoints.env setzen
#   2. ./scripts/render-config.py
#   3. ./scripts/update.sh   (oder: docker compose restart nginx)
#   4. Pruefen:  ./scripts/check-zabbix.sh
# -----------------------------------------------------------------------------

# --- 2. Zabbix-Oberflaeche fuer eingebettete Dashboards ----------------------
#     Aufruf an der Wand z. B.:
#     /zabbix/zabbix.php?action=dashboard.view&dashboardid=42&kiosk=1
#
#     kiosk=1 blendet Menue und Kopfzeile aus - genau richtig fuer die Wand.
#     Damit ohne Anmeldung etwas zu sehen ist, in Zabbix EINES von beiden:
#       a) Dashboard mit dem Benutzer "guest" teilen (Sharing -> Public), oder
#       b) einen eigenen Nur-Lese-Benutzer anlegen und HTTP-Auth verwenden.
# Ohne Schraegstrich am Ende auf die Proxy-Wurzel umlenken.
location = /zabbix { return 301 /zabbix/; }

# Named Capture statt rewrite: die Ziel-URL wird hier VOLLSTAENDIG und
# explizit zusammengesetzt.
#
# Warum nicht "rewrite ... break" plus "proxy_pass $var":
# Steht in proxy_pass eine Variable OHNE Pfad, reicht Nginx die urspruengliche
# Anfrage-URI weiter - nicht die umgeschriebene. Die Umschreibung lief also ins
# Leere, und je nach Zusammenspiel endet das in einem 500 statt in einer
# verstaendlichen Meldung. Mit $zbxuri ist nichts mehr implizit.
location ~ ^/zabbix/(?<zbxuri>.*)$ {
    # ZABBIX_ORIGIN = schema://host[:port], ZABBIX_PATH = Basispfad des
    # Servers ("/zabbix" bei Paketinstallation, leer wenn Zabbix auf / liegt).
    set $zbxui "${ZABBIX_ORIGIN}";
    proxy_pass $zbxui${ZABBIX_PATH}/$zbxuri$is_args$args;

    proxy_set_header Host "${ZABBIX_HOST}";
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_verify off;
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;

    # Der eigentliche Trick, falls Zabbix die Einbettung sperrt.
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Content-Security-Policy;

    # Weiterleitungen und Cookies auf unseren Pfad umbiegen, sonst springt die
    # Wand beim ersten Redirect aus dem Proxy heraus.
    proxy_redirect ~^https?://[^/]+${ZABBIX_PATH}/(.*)$ /zabbix/$1;
    proxy_redirect ~^https?://[^/]+/(.*)$ /zabbix/$1;
    proxy_cookie_path ${ZABBIX_PATH}/ /zabbix/;

    add_header Cache-Control "no-store" always;
}
