# -----------------------------------------------------------------------------
# Zabbix an der Wand - zwei Wege, beide serverseitig.
#
#  1. /api/zabbix   JSON-RPC fuer die Betriebslage-Wand (/lage/).
#  2. /zabbix/      Reverse-Proxy auf die Zabbix-Oberflaeche, damit eigene
#                   Zabbix-Dashboards als Vollbild eingebettet werden koennen.
#
# WARUM SERVERSEITIG: Der Browser darf die Zabbix-API nicht direkt aufrufen
# (CORS), und ein API-Token gehoert niemals in eine Seite, die auf einer Wand
# im Flur laeuft. Nginx haengt den Token hier an - er verlaesst den Container
# nie und steht nicht im Quelltext der Wand.
#
# WARUM DER PROXY FUER DASHBOARDS NOETIG IST: Zabbix sendet
# "X-Frame-Options: SAMEORIGIN". Ein <iframe> auf https://zabbix.example.local
# bleibt darum von unserer Wand aus leer - der Browser blockt es wortlos. Ueber
# diesen Proxy laeuft Zabbix unter UNSERER Adresse, also same-origin, und die
# Kopfzeile wird zusaetzlich entfernt. Erst dadurch wird das Bild sichtbar.
#
# EINRICHTEN:
#   1. In config/endpoints.env  ZABBIX_URL setzen
#      In config/secrets.env    ZABBIX_API_TOKEN setzen
#      (Zabbix: Users -> API tokens, eine nur-lesende Rolle genuegt)
#   2. ./scripts/render-config.py   (traegt die Werte hier ein)
#   3. ./scripts/update.sh          (oder: docker compose restart nginx)
#
# Die gerenderte zabbix.conf ist gitignored und wird nie committet.
# -----------------------------------------------------------------------------

# --- 1. JSON-RPC fuer die Betriebslage-Wand ----------------------------------
location = /api/zabbix {
    limit_except POST { deny all; }

    set $zbx "${ZABBIX_URL}/api_jsonrpc.php";
    proxy_pass $zbx;
    # Host muss der reine Hostname sein, nicht die komplette URL - sonst
    # antwortet Zabbix mit einem Fehler oder gar nicht.
    proxy_set_header Host "${ZABBIX_HOST}";
    proxy_set_header Content-Type "application/json-rpc";
    proxy_set_header Authorization "Bearer ${ZABBIX_API_TOKEN}";
    proxy_ssl_server_name on;
    # Internes Zabbix-Zertifikat wird nicht geprueft (Standard bei Nginx-Proxy):
    proxy_ssl_verify off;
    proxy_connect_timeout 10s;
    proxy_read_timeout 20s;
    proxy_hide_header Set-Cookie;
    default_type application/json;
    add_header Cache-Control "no-store" always;
}

# --- 2. Zabbix-Oberflaeche fuer eingebettete Dashboards ----------------------
#     Aufruf an der Wand z. B.:
#     /zabbix/zabbix.php?action=dashboard.view&dashboardid=42&kiosk=1
#
#     kiosk=1 blendet Menue und Kopfzeile aus - genau richtig fuer die Wand.
#     Damit ohne Anmeldung etwas zu sehen ist, in Zabbix EINES von beiden:
#       a) Dashboard mit dem Benutzer "guest" teilen (Sharing -> Public), oder
#       b) einen eigenen Nur-Lese-Benutzer anlegen und HTTP-Auth verwenden.
location /zabbix/ {
    # Steht in proxy_pass eine Variable, ersetzt Nginx den Pfad NICHT selbst -
    # das Ziel bekaeme "/zabbix/zabbix.php" statt "/zabbix.php" und antwortete
    # mit 404. Das Praefix muss darum von Hand weg.
    rewrite ^/zabbix/(.*)$ /$1 break;

    set $zbxui "${ZABBIX_URL}";
    proxy_pass $zbxui;
    proxy_set_header Host "${ZABBIX_HOST}";
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_ssl_server_name on;
    proxy_ssl_verify off;
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;

    # Der eigentliche Trick: Zabbix' Einbettungssperre entfernen.
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Content-Security-Policy;

    # Weiterleitungen von Zabbix auf unseren Pfad umbiegen, sonst springt die
    # Wand beim Anmelden aus dem Proxy heraus.
    proxy_redirect ~^https?://[^/]+/(.*)$ /zabbix/$1;

    # Zabbix setzt Sitzungs-Cookies auf "/" - hier passend umschreiben.
    proxy_cookie_path / /zabbix/;

    # Dashboards laden im Hintergrund nach; kein Zwischenspeicher.
    add_header Cache-Control "no-store" always;
}
