# -----------------------------------------------------------------------------
# Zabbix-Alarme für die Alert-Wand (/wall/).
#
# WARUM SERVERSEITIG: Der Browser darf die Zabbix-API nicht direkt aufrufen
# (CORS), und ein API-Token gehört niemals in eine Seite, die auf einer Wand
# im Flur läuft. Nginx hängt den Token hier serverseitig an - er verlässt den
# Container nie und steht nicht im Quelltext der Wand.
#
# EINRICHTEN:
#   1. cp zabbix.conf.example zabbix.conf
#   2. ZABBIX-URL und TOKEN unten eintragen (Zabbix: Users -> API tokens,
#      nur-lesende Rolle genügt)
#   3. docker compose restart nginx
#   4. In assets/wall.html ZABBIX_ENABLED auf true setzen
#
# zabbix.conf ist per .gitignore ausgenommen und wird nicht committet.
# -----------------------------------------------------------------------------

location = /api/zabbix {
    # Nur POST (JSON-RPC) zulassen.
    limit_except POST { deny all; }

    set $zbx "https://DEINE-ZABBIX-URL/api_jsonrpc.php";
    proxy_pass $zbx;
    proxy_set_header Host "DEINE-ZABBIX-URL";
    proxy_set_header Content-Type "application/json-rpc";
    # <-- Token hier eintragen; ersetzt DEIN_ZABBIX_API_TOKEN
    proxy_set_header Authorization "Bearer DEIN_ZABBIX_API_TOKEN";
    proxy_ssl_server_name on;
    # Internes Zabbix-Zertifikat wird nicht geprüft (Standard bei nginx-Proxy):
    proxy_ssl_verify off;
    proxy_connect_timeout 10s;
    proxy_read_timeout 20s;
    proxy_hide_header Set-Cookie;
    default_type application/json;
    add_header Cache-Control "no-store" always;
}
