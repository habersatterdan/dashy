# -----------------------------------------------------------------------------
# JSON-RPC-Zugang fuer die Problemliste auf der Betriebslage-Wand (/lage/).
#
# Braucht ZABBIX_URL UND ZABBIX_API_TOKEN. Fehlt der Token, wird diese Datei
# nicht geschrieben - die Zabbix-Spalte auf /lage/ bleibt dann einfach weg.
# Das Einbetten von Dashboards laeuft davon unabhaengig ueber zabbix-ui.conf.
#
# WARUM SERVERSEITIG: Der Browser darf die Zabbix-API nicht direkt aufrufen
# (CORS), und ein API-Token gehoert niemals in eine Seite, die auf einer Wand
# im Flur laeuft. Nginx haengt den Token hier an - er verlaesst den Container
# nie und steht nicht im Quelltext der Wand.
#
# WARUM DER PROXY FUER DASHBOARDS NOETIG IST: Zabbix sendet
# "X-Frame-Options: SAMEORIGIN". Ein <iframe> auf https://zabbix.example.local
# bleibt darum von unserer Wand aus leer - der Browser blockt es wortlos. Ueber
# diesen Proxy laeuft Zabbix unter UNSERER Adresse, also same-origin, und die
# Kopfzeile wird zusaetzlich entfernt. Erst dadurch wird das Bild sichtbar.
#
# EINRICHTEN:
#   1. In config/endpoints.env  ZABBIX_URL setzen
#      In config/secrets.env    ZABBIX_API_TOKEN setzen
#      (Zabbix: Users -> API tokens, eine nur-lesende Rolle genuegt)
#   2. ./scripts/render-config.py   (traegt die Werte hier ein)
#   3. ./scripts/update.sh          (oder: docker compose restart nginx)
#   4. Pruefen:  ./scripts/check-zabbix.sh
#
# Die gerenderte Datei ist gitignored und wird nie committet.
# -----------------------------------------------------------------------------

location = /api/zabbix {
    limit_except POST { deny all; }

    # ----------------------------------------------------------------------
    # SICHERHEIT: nur lesende Methoden durchlassen.
    #
    # Ohne diese Pruefung haengt Nginx den API-Token an JEDE Anfrage, die
    # jemand hierher schickt. Wer den Pi im Netz erreicht, koennte damit
    # host.delete, user.create oder script.execute aufrufen - mit den Rechten
    # des Tokens. Der Token sollte durch den serverseitigen Proxy geschuetzt
    # werden; ohne Filter wird der Proxy stattdessen zum offenen Tor.
    #
    # Der Koerper muss in den Puffer passen, sonst ist $request_body leer -
    # und ein leerer Koerper faellt durch das Muster und wird abgewiesen.
    # Eine Abfrage der Wand ist wenige hundert Byte gross.
    client_max_body_size 8k;
    client_body_buffer_size 8k;
    if ($request_body !~ "\"method\"[ ]*:[ ]*\"(problem\.get|trigger\.get|host\.get|hostgroup\.get|hostinterface\.get|event\.get|item\.get|service\.get|maintenance\.get|apiinfo\.version)\"") {
        return 403 "{\"error\":\"nur lesende Zabbix-Methoden sind erlaubt\"}";
    }
    # Missbrauch bremsen: die Wand fragt alle 20 s, mehr braucht niemand.
    limit_req zone=zbxapi burst=10 nodelay;

    # ZABBIX_BASE ist die bereinigte Basis (ohne Query, ohne .php-Datei) -
    # eine aus der Adresszeile kopierte Dashboard-URL wuerde den Aufruf
    # sonst auf der HTML-Seite landen lassen und Zabbix antwortet mit
    # "You are not logged in" statt mit JSON.
    set $zbx "${ZABBIX_BASE}/api_jsonrpc.php";
    proxy_pass $zbx;
    # Host muss der reine Hostname sein, nicht die komplette URL - sonst
    # antwortet Zabbix mit einem Fehler oder gar nicht.
    proxy_set_header Host "${ZABBIX_HOST}";
    proxy_set_header Content-Type "application/json-rpc";
    proxy_set_header Authorization "Bearer ${ZABBIX_API_TOKEN}";
    proxy_ssl_server_name on;
    # Internes Zabbix-Zertifikat wird nicht geprueft (Standard bei Nginx-Proxy):
    proxy_ssl_verify off;
    proxy_connect_timeout 10s;
    proxy_read_timeout 20s;
    proxy_hide_header Set-Cookie;
    default_type application/json;
    add_header Cache-Control "no-store" always;
}
