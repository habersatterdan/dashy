# -----------------------------------------------------------------------------
# systemd system service: brings the Docker Compose stack up at boot.
# Install:
#   sudo cp dashy-stack.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dashy-stack.service
# Adjust WorkingDirectory to where this repo is checked out.
# -----------------------------------------------------------------------------
[Unit]
Description=NOC Signage Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/home/pi/dashy
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
